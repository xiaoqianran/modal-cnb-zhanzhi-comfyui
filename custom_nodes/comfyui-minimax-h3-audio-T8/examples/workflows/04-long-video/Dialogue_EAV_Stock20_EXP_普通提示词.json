      "title": "7. Dialogue-safe Long Video + Prompt Relay + EAV · Stock20",
      "properties": {
        "Node name for S&R": "MiniMaxH3LongVideoInNodeLoopEffectsT8Advanced",
        "widget_ue_connectable": {}
