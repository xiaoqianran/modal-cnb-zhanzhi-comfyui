# Copy to .env and export before `modal serve` / `modal deploy`.
# All keys are optional; defaults match zhanzhi CNB (CUDA 13 / torch cu130 / L40S).

# MODAL_GPU=L40S
# MODAL_APP_NAME=zhanzhi-comfyui
# MODAL_MODELS_VOLUME=zhanzhi-comfy-models
# MODAL_DATA_VOLUME=zhanzhi-comfy-data
# CNB_REPO_URL=https://cnb.cool/zhan_zhi/ComfyUI.git
# CNB_REPO_REF=main
# MODAL_BAKE_CNB=1
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# MODAL_CUDA_IMAGE=nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04
# MODAL_SECRETS=huggingface
# COMFY_EXTRA_ARGS=
# COMFY_HIGHVRAM=
# PREFETCH=1
