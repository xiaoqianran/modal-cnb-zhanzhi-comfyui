#!/bin/bash

# =================================================================================================
# ComfyUI 极致优化启动脚本 (融合 V13.5 & V15.1 优点)
# 核心特性：
#   1. L40/H20 硬件感知的智能缓存策略 (--cache-none vs --cache-ram 4)
#   2. 深度显存管理：强制全量加载模型，禁用 LowVRAM 降级，开启 0.6 显存回收阈值
#   3. 终极稳定性：解决 CUDA invalid argument 和 VAE 黑屏问题
#   4. 极速启动：开启 CUDA_MODULE_LOADING=LAZY 与模块化清理
# =================================================================================================

set -e

# --- 1. 强效进程清理 ---
echo "🧹 Cleaning up previous processes..."
pkill -f "python main.py" || true
pkill -f "comfyui" || true
sleep 1

# --- 2. 阿里源与环境注入 ---
export PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"
export PIP_TRUSTED_HOST="mirrors.aliyun.com"
export HF_ENDPOINT="https://hf-mirror.com"
export UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"

# 【新增】极速加载：CUDA 内核延迟加载
export CUDA_MODULE_LOADING=LAZY

# 激活虚拟环境
VENV_ACTIVATE_PATH="/workspace/venv312/bin/activate"
if [ -f "$VENV_ACTIVATE_PATH" ]; then
    source "$VENV_ACTIVATE_PATH"
else
    echo "⚠️ Warning: Virtual environment not found."
fi

# --- 3. 硬件型号精准识别 ---
GPU_MODEL_RAW=$(nvidia-smi --query-gpu=name --format=csv,noheader,nounits 2>/dev/null | head -n 1 | xargs)
GPU_MODEL_CLEAN=$(echo "$GPU_MODEL_RAW" | tr '[:upper:]' '[:lower:]' | sed 's/ //g;s/-//g;s/_//g')

IS_L40=0
if [[ "$GPU_MODEL_CLEAN" == *"l40"* ]]; then
    echo "✅ Detected NVIDIA L40 (48GB VRAM) - Optimized for high throughput"
    IS_L40=1
elif [[ "$GPU_MODEL_CLEAN" == *"h20"* ]]; then
    echo "✅ Detected NVIDIA H20 (96GB VRAM) - Optimized for large cache"
    IS_L40=0
else
    echo "⚠️ Unknown GPU ($GPU_MODEL_RAW) - Using generic optimization"
fi

# --- 4. 终极 CUDA 与显存策略 (融合核心) ---
# [稳定性] 解决 invalid argument 和非法内存访问
export CUDA_LAUNCH_BLOCKING=0  # 生产环境建议0（性能），若频繁报错改1调试
export TORCH_USE_CUDA_DSA=1
export CUDA_VISIBLE_DEVICES=0

# [显存/碎片管理] 融合 start.sh 的 0.6 自动回收与 VAE 修复
# backend:cudaMallocAsync + expandable_segments 彻底降低显存残留
export PYTORCH_ALLOC_CONF="backend:cudaMallocAsync,expandable_segments:True,garbage_collection_threshold:0.6"

# [强制全量加载] 禁用 ComfyUI 的 LowVRAM 降级逻辑（因为 L40/H20 显存足够）
# 避免模型在 VRAM 和 RAM 之间反复交换导致浪费和报错
export COMFY_FORCE_FULL_MODEL_LOAD=1
export COMFY_DISABLE_LOWVRAM_FALLBACK=1
export COMFY_NO_LOWVRAM=1

# [内存管理] 针对 glibc 优化，防止 RAM 溢出
export MALLOC_TRIM_THRESHOLD_=67108864

# --- 5. 硬件专属 CPU 线程配置 ---
if [ $IS_L40 -eq 1 ]; then
    export OMP_NUM_THREADS=8
    export MKL_NUM_THREADS=8
else
    export OMP_NUM_THREADS=32
    export MKL_NUM_THREADS=32
fi

# --- 6. 目录清理与预处理 ---
cd "/workspace/ComfyUI" || exit 1
echo "🔧 Cleaning temporary caches..."
rm -rf ./cache ./temp >/dev/null 2>&1

mkdir -p output input /workspace/输出 /workspace/输入
ln -snf /workspace/ComfyUI/output /workspace/输出 >/dev/null 2>&1
rm -rf /workspace/ComfyUI/input
ln -snf /workspace/输入 /workspace/ComfyUI/input >/dev/null 2>&1

# --- 7. CUDA 预载 (无报错初始化) ---
python -W ignore::FutureWarning -c "import torch; torch.cuda.init(); torch.cuda.empty_cache(); print('✅ CUDA initialized and cache cleared.')"

# --- 8. 智能生成 ComfyUI 启动参数 ---
# 基础参数
COMFY_ARGS=(
    --listen
    --port 8188
    --enable-cors-header
    --preview-method auto
    --disable-cuda-malloc      # 必须开启，以应用 PYTORCH_ALLOC_CONF 的自定义策略
    --normalvram               # 强制普通显存模式，拒绝分块加载
)

# [核心优化] 差异化模型策略
if [ $IS_L40 -eq 1 ]; then
    # L40：48G 显存，由于任务更重，禁用所有内部缓存，确保显存实时释放
    COMFY_ARGS+=(--cache-none)
    echo "🚀 Strategy: L40 (No internal cache, priority for VRAM freedom)"
else
    # H20：96G 显存，不仅全量加载，还开启 4GB 的 RAM 缓存加速模型切换
    COMFY_ARGS+=(--cache-ram 4)
    echo "🚀 Strategy: H20 (RAM caching enabled, priority for model switching speed)"
fi

# --- 9. 最终启动 ---
echo -e "\n===== Final Execution Command ====="
echo "python main.py ${COMFY_ARGS[*]}"
echo "====================================\n"

exec python main.py "${COMFY_ARGS[@]}"
