#!/bin/bash
. /workspace/venv312/bin/activate
# 重新安装hydra-core（包含ANTLR文件）
pip uninstall hydra-core -y
# 优先尝试本地whl文件安装，失败则使用官方源安装
if ! pip install /workspace/assets/tools/cache/hydra_core-1.3.2-py3-none-any.whl; then
    echo "本地whl文件安装hydra-core失败，将使用官方源重试..."
    pip install hydra-core==1.3.2 -i https://pypi.org/simple/
fi