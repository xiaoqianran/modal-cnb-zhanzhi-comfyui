":{"name":"clear_vram_between_segments"}},{"label":"export_source_images","localized_name":"export_source_images","name":"export_source_images","shape":7,"type":"BOOLEAN","widget":{"name":"export_source_images"}}],"outputs":[{"label":"images","localized_name":"images","name":"images","shape":6,"type":"IMAGE","links":[17]},{"label":"audio","localized_name":"audio","name":"audio","shape":6,"type":"AUDIO","links":[18]},{"label":"fps","localized_name":"fps","name":"fps","type":"FLOAT","links":[19]},{"label":"frame_count","localized_name":"frame_count","name":"frame_count","type":"INT"},{"label":"source_images","localized_name":"source_images","name":"source_images","shape":6,"type":"IMAGE"},{"label":"report","localized_name":"report","name":"report","type":"STRING","links":[]},{"localized_name":"images_pre_refine","name":"images_pre_refine","shape":6,"type":"IMAGE","links":null}],"properties":{"aux_id":"AIMixer/ComfyUI_MiniMaxH3_Director","ver":"6aa33a62193822bb6cfd54e6491c082b435d1076","Node name for S&R":"MiniMaxH3Director","widget_ue_connectable":{"shift_audio":true,"seed":true,"shift_video":true,"export_source_images":true,"cfg":true,"global_prompt":true,"timeline_data":true,"bd_grp_sample":true,"frame_rate":true,"steps":true,"total_frames":true,"sampler":true,"bd_grp_perf":true,"scheduler":true,"clear_vram_between_segments":true,"width":true,"ref_max_size":true,"bd_grp_advanced":true,"task_type":true,"height":true}},"widgets_values":["fl2v — 首尾帧生视频(First-Last Frame)","","采样设置",1,333,"fixed",24,576,736,736,124,"{\"version\":5,\"editMode\":\"segment\",\"totalFrames\":124,\"frameRate\":24,\"video\":{\"fileName\":\"\",\"videoFile\":\"\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[],\"sourceFrameCount\":124,\"deletedSourceRanges\":[]},\"videoClips\":[],\"global\":{\"taskType\":\"fl2v — 首尾帧生视频(First-Last Frame)\",\"prompt\":\"\",\"refs\":[],\"referenceVideo\":{\"videoFile\":\"\",\"fileName\":\"\",\"type\":\"input\",\"subfolder\":\"\"},\"continuousReference\":false,\"genImage\":{\"imageFile\":\"\"},\"sourceWidth\":768,\"sourceHeight\":1024,\"refAudios\":[],\"refVideos\":[],\"commonEnabled\":false,\"commonCollapsed\":false},\"output\":{\"mode\":\"fixed\",\"aspectRatio\":\"3:4 (竖版标准)\",\"megapixels\":0.4,\"multiple\":32,\"longEdge\":736,\"width\":576,\"height\":736,\"maxExportFrames\":0,\"exportMode\":\"all\",\"audioMode\":\"generate\",\"continuityEnabled\":false,\"continuityOverlapFrames\":5},\"runSelectEnabled\":false,\"runSelection\":[],\"segments\":[{\"id\":\"mstcihbqr5wtf\",\"start\":0,\"length\":124,\"frameCount\":124,\"durationSec\":5,\"prompt\":\"integrated_multimodal_description\\n画面开场于纯白极简摄影棚内，一位身穿浅粉色运动内衣和高腰紧身瑜伽裤的年轻女性正保持舞王式瑜伽体式。她左腿垂直站立于浅灰色水泥地面上，右腿向后上方高高抬起，膝关节弯曲，右手握住右脚背，左臂向前平伸，手掌轻贴左侧白墙。黑色长发自然垂落，侧脸朝向画面左侧，神情专注平静。柔和的漫射光从左前方均匀照亮全身，高调摄影，背景为纯白色L型转角墙面。\\n\\n第1秒至第2秒，人物缓缓松开右手，右腿从高位平稳下降，同时左手从墙面收回，身体重心微微前移。动作流畅连贯，如呼吸般自然过渡，肌肉线条在柔和光影下呈现细腻的明暗变化。相机保持固定机位，微微推进，视角不变。\\n\\n第2秒至第4秒，右脚轻盈落地，双脚并拢站立瞬间，躯干随即向前柔和弯曲下沉。双臂从前方自然向前延伸舒展，背部呈现优美的弧线。长发随身体前倾的动作从肩背滑落至右侧，发丝在空中划出柔和的弧线轨迹。整个过渡如同一个完整的呼吸循环，从后弯到前屈，力量与柔韧并存。\\n\\n第4秒至第5秒，身体完全进入前屈伸展姿态，双臂向前充分延伸，双手超出画面左侧边缘，背部弧线定型。人物面部朝向镜头，表情平静而略带冷感，目光平视。画面定格于尾帧构图，人物位于画面中央偏右，身体从左上向右下对角线延伸，背景大面积留白。光影保持一致的柔和漫射光，整体色调维持粉白灰的柔和配色体系，高明亮低对比度，清新通透。\\n\\noverall_soundscape\\n环境音为极安静的室内空间底噪，几乎无声。可听到细微的呼吸声，在动作过渡过程中呼吸节奏从平稳到轻柔吐气，传递专注内敛的氛围。脚掌轻触地面落地时有一声极轻柔的接触音。整体音景极简克制的，突出画面的宁静感与运动的优雅感。\\n\\nnon_diegetic_music\\n配乐为一段轻柔的氛围钢琴音色，音域偏高，音符稀疏而留白充足，带有微弱的混响尾音。节奏极慢，约60BPM，与人物动作的呼吸节奏同步。在第2秒动作过渡处加入一声低频的弦乐持续音，营造支撑感与流动感。第4秒进入尾段时钢琴音逐渐稀疏，最后一两个音符轻轻消散于静默中，与画面的定格形成呼应。整体音乐风格为极简主义ambient，干净通透，不喧宾夺主。\",\"negativePrompt\":\"bad video\",\"continuityFromPrev\":false,\"isStartFrame\":true,\"isEndFrame\":true,\"genImage\":{\"imageFile\":\"H3-11.jpg\",\"width\":1080,\"height\":1481},\"endImage\":{\"imageFile\":\"H3-12.jpg\",\"width\":1080,\"height\":1575},\"taskType\":\"\",\"refs\":[]}],\"timelineMode\":\"fl2v\",\"width\":576,\"height\":736,\"refMaxSize\":736,\"gen\":{\"defaultFrameCount\":124},\"keyframes\":[{\"id\":\"mstcihbqr5wtf_s\",\"imageF