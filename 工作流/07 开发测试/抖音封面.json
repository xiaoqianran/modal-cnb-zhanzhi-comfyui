/山脉）、蓝色（溪流/服饰），搭配金色（凤凰羽毛/云纹/文字描边）、青灰色（吊脚楼屋顶/石桥），传统工笔与现代扁平结合线条流畅，“来”“凤”字笔画间隙添加淡金色云纹，溪流中有棕色落叶带叶脉，吊脚楼木柱有木纹纹理"],"color":"#232","bgcolor":"#353"},{"id":119,"type":"easy seed","pos":[-2138.5539476939957,2499.949857313192],"size":[212.89286530182835,116.57542758802128],"flags":{},"order":8,"mode":0,"inputs":[{"label":"随机种子","localized_name":"随机种子","name":"seed","type":"INT","widget":{"name":"seed"},"link":null}],"outputs":[{"label":"随机种子","localized_name":"随机种子","name":"seed","type":"INT","links":[141]}],"properties":{"Node name for S&R":"easy seed"},"widgets_values":[715399857218178,"randomize",null]},{"id":116,"type":"Note","pos":[-2398.7873565737923,2333.214302139112],"size":[210,90.62655530155007],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["横版封面尺寸\n"],"color":"#432","bgcolor":"#653"},{"id":120,"type":"Note","pos":[-2393.7873565737923,2516.9385152273057],"size":[210,90.62655530155007],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["生成种子"],"color":"#432","bgcolor":"#653"},{"id":110,"type":"CLIPTextEncode","pos":[-769.8395540182453,3008.5381459808386],"size":[210,110.14087521037368],"flags":{},"order":15,"mode":0,"inputs":[{"label":"CLIP","localized_name":"clip","name":"clip","type":"CLIP","link":135},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":140}],"outputs":[{"label":"条件","localized_name":"条件","name":"CONDITIONING","type":"CONDITIONING","links":[129,131]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.75","Node name for S&R":"CLIPTextEncode","widget_ue_connectable":{"text":true}},"widgets_values":[""]},{"id":5,"type":"CLIPTextEncode","pos":[-765.2782908452531,2274.698563821314],"size":[210,110.14087521037368],"flags":{},"order":14,"mode":0,"inputs":[{"label":"CLIP","localized_name":"clip","name":"clip","type":"CLIP","link":2},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":138}],"outputs":[{"label":"条件",