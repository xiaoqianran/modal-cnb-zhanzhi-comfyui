山间缭绕淡白色云雾，天空一只金色凤凰（位于“凤”字上方展翅飞翔渐变金羽毛红喙）；主色调红色（“来”“凤”字）、绿色（茶园/山脉）、蓝色（溪流/服饰），搭配金色（凤凰羽毛/云纹/文字描边）、青灰色（吊脚楼屋顶/石桥），“来”“凤”字笔画间隙添加淡金色云纹，溪流中有棕色落叶带叶脉，吊脚楼木柱有木纹纹理，白色背景"],"color":"#232","bgcolor":"#353"},{"id":234,"type":"ImageInvert","pos":[-3525.2361561244165,2588.050188985024],"size":[187.5,34.453125],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"IMAGE","link":403}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[413,419,421,430]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.70","Node name for S&R":"ImageInvert"},"widgets_values":[]},{"id":243,"type":"ZML_DualInteger","pos":[-3436.2142745465117,3577.8216574984804],"size":[269.9869791666667,111.10677083333334],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"A","name":"A","type":"INT","widget":{"name":"A"},"link":null},{"localized_name":"B","name":"B","type":"INT","widget":{"name":"B"},"link":null}],"outputs":[{"localized_name":"A","name":"A","type":"INT","links":[]},{"localized_name":"B","name":"B","type":"INT","links":[]}],"title":"分辨率","properties":{"Node name for S&R":"ZML_DualInteger"},"widgets_values":[1080,1464]},{"id":250,"type":"GetImageSize","pos":[-1978.0574383328883,2462.418685329664],"size":[140,124],"flags":{},"order":13,"mode":0,"inputs":[{"label":"图像","localized_name":"图像","name":"image","type":"IMAGE","link":440}],"outputs":[{"label":"宽度","localized_name":"宽度","name":"width","type":"INT","links":[438]},{"label":"高度","localized_name":"高度","name":"height","type":"INT","links":[439]},{"localized_name":"批处理大小","name":"batch_size","type":"INT","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.3.75","Node name for S&R":"GetImageSize"},"widgets_values":[]},{"id":160,"type":"CR Seed","pos":[-3426.1045024822747,3727.1867319741423],"size":[259.3359375,102],"flags":{},"order":7,"mode":0,"inputs":[{"label":"随机种","localized_name":"随机种","name":"seed","type":"INT","widget":{"name":"seed"},"link":null}],"outputs":[{"label":"随机种","localized