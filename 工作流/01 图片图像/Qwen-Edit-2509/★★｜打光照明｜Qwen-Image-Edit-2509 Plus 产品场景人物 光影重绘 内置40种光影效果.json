照明\n\n28：使用透过烟雾/灰尘的光束的光线对图片进行重新照明\n\n29：使用水面反射光（波纹投影）的光线对图片进行重新照明\n\n30：使用镜面反射（镜子、玻璃）的光线对图片进行重新照明\n\n31：使用棱镜分光（七彩分解）的光线对图片进行重新照明\n\n32：使用水晶/玻璃折射光斑的光线对图片进行重新照明\n\n33：使用水下光斑（涟漪折射）的光线对图片进行重新照明\n\n34：使用窗格光影（透过窗户结构形成图案）的光线对图片进行重新照明\n\n35：使用百叶窗条纹光的光线对图片进行重新照明\n\n36：使用玻璃彩窗投影（教堂彩色光影）的光线对图片进行重新照明\n\n37：使用都市夜景光（车灯轨迹、霓虹反射）的光线对图片进行重新照明\n\n38：使用雕花镂空投影的光线对图片进行重新照明\n\n39：使用缝隙光（斑驳光影）的光线对图片进行重新照明\n\n\n\n"],"color":"#322","bgcolor":"#533"},{"id":77,"type":"UNETLoader","pos":[-810,800],"size":[350,82],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"UNet名称","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"localized_name":"数据类型","name":"weight_dtype","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"label":"模型","localized_name":"模型","name":"MODEL","type":"MODEL","links":[124]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.64","Node name for S&R":"UNETLoader"},"widgets_values":["qwen_image_edit_2509_bf16.safetensors","default"]},{"id":81,"type":"LoraLoaderModelOnly","pos":[-70,810],"size":[300,82],"flags":{},"order":11,"mode":0,"inputs":[{"label":"模型","localized_name":"模型","name":"model","type":"MODEL","link":128},{"localized_name":"LoRA名称","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"localized_name":"模型强度","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"label":"模型","localized_name":"模型","name":"MODEL","type":"MODEL","links":[129]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.49","Node name for S&R":"LoraLoaderModelOnly","models":[{"name":"Qwen-Image-Lightning-8steps-V1.0.safetensors","url":"https://huggingface.co/lightx2v/Qwen-Image-Lightning/resolve/main/Qwen-Image-Lightning-8steps-V1.0.safetensors","directory":"loras"}]},"widgets_values":["重新照明打光_Qwen-Edit-2509.safetensors",1]},{"id":20,"type":"LoraLoaderModelOnly","pos":[-430,810],"size":[350,82],"flags":{},"order":7,"mode":0,"inputs":[{"label":"模型","localized_name":"模型","name":